# Exemple de variables d'environnement (copier vers .env si nécessaire)
# ATTENTION : Ne jamais committer le fichier .env réel !
#
# Les identifiants AWS ne vont PAS ici : ils sont lus automatiquement depuis
# ~/.aws/credentials (AWS Academy Learner Lab : bloc "AWS Details" > "AWS CLI",
# à recopier à chaque nouvelle session). Sur AWS, la Lambda utilise le rôle LabRole.
#
# Toutes ces variables sont optionnelles : par défaut, config/settings.yaml s'applique.

# "local" = stockage fichier sans frais ; "live" = DynamoDB réel
APP_MODE=local
AWS_REGION=us-east-1

# Noms des ressources AWS (injectés automatiquement dans la Lambda par le template)
ALERTS_TABLE=FraudDetectionAlerts
TRANSACTIONS_TABLE=FraudDetectionTransactions
CARD_HISTORY_TABLE=FraudDetectionCardHistory
KINESIS_STREAM=banking-transactions-stream
METRICS_NAMESPACE=BankingFraudDetection

# Agent LLM : "mock" (analyse déterministe) ou "bedrock"
LLM_PROVIDER=mock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

STREAMLIT_SERVER_PORT=8501
