# Exemple de variables d'environnement (copier vers .env si nécessaire)
# ATTENTION : Ne jamais committer le fichier .env réel contenant des clés secrètes !

AWS_DEFAULT_REGION=eu-west-3
AWS_ACCESS_KEY_ID=votre_cle_acces_ici
AWS_SECRET_ACCESS_KEY=votre_cle_secrete_ici
AWS_SESSION_TOKEN=token_session_optionnel

# Paramètres de l'application
FRAUD_DETECTION_MODE=local
STREAMLIT_SERVER_PORT=8501
